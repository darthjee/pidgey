{
  "name": "pidgey-client",
  "version": "0.1.0",
  "description": "Node.js client library for the Pidgey email-delivery API",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darthjee/pidgey.git",
    "directory": "clients/nodejs"
  },
  "exports": {
    ".": "./lib/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "lib/"
  ],
  "scripts": {
    "lint": "eslint lib specs",
    "typecheck": "tsc --allowJs --checkJs --noEmit -p .",
    "test": "jasmine \"specs/**/*_spec.js\"",
    "coverage": "c8 jasmine \"specs/**/*_spec.js\"",
    "generate:types": "openapi-typescript ../../source/openapi/v1.json -o types/v1.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "c8": "11.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jasmine": "^4.1.3",
    "eslint-plugin-jsdoc": "61.5.0",
    "globals": "^16.5.0",
    "jasmine": "^5.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.9.3"
  },
  "c8": {
    "reporter": [
      "text",
      "lcov"
    ],
    "include": [
      "lib/**/*.js"
    ],
    "exclude": [
      "specs/**",
      "coverage/**"
    ],
    "all": true,
    "check-coverage": true,
    "lines": 100,
    "branches": 100,
    "functions": 100,
    "statements": 100
  }
}
