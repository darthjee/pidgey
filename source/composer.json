{
    "name": "darthjee/pidgey",
    "description": "Pidgey email-delivery service",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "monolog/monolog": "^3.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.13",
        "slevomat/coding-standard": "^8.20",
        "phpmd/phpmd": "^2.15"
    },
    "autoload": {
        "psr-4": {
            "Pidgey\\": "lib/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
