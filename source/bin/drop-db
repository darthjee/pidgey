#!/usr/bin/env php
<?php

declare(strict_types=1);

use Pidgey\Infra\Cli\DatabaseCommand;
use Pidgey\Infra\EnvFile;
use Pidgey\Infra\Runtime;

require __DIR__ . '/../vendor/autoload.php';

EnvFile::load(__DIR__ . '/../config/.env');
Runtime::harden();

exit(DatabaseCommand::fromEnvironment(__DIR__ . '/../migrations', STDOUT, STDERR)->dropDb());
