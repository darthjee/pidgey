CGIPassAuth On
Options -Indexes
RewriteEngine On
RewriteRule (^|/)\. - [R=404,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# HSTS: sent over HTTPS only. Staged rollout: now at one day (#115);
# one year is a later step. No includeSubDomains: other subdomains
# of the parent domain are not ours.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=86400" "expr=%{HTTPS} == 'on'"
</IfModule>
