# Development-only values. Never put real secrets in this file.

# mysql:9 image (applied only when docker_volumes/mysql_data is empty)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=pidgey_development
MYSQL_USER=pidgey
MYSQL_PASSWORD=pidgey

# Application database
DB_HOST=mysql
DB_PORT=3306
DB_NAME=pidgey_development
DB_USER=pidgey
DB_PASSWORD=pidgey

# Application SMTP (mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
